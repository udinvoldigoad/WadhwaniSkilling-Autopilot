# 9Router (OpenAI-compatible). Sesuaikan port & model dengan setup 9Router kamu.
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=isi-api-key-9router
AI_MODEL=isi-nama-model

# Maks pelajaran per run (bot klik "Pelajaran Selanjutnya" di antaranya). Default 5.
MAX_PELAJARAN=5

# Opsional: model khusus yang bisa baca gambar (default: AI_MODEL)
# AI_VISION_MODEL=
